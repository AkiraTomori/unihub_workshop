# UniHub Workshop — Environment Variables Template
# Copy this file to .env and update values for your environment

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

NODE_ENV=development
APP_PORT=3000
LOG_LEVEL=info

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================

DB_HOST=postgres
DB_PORT=5432
DB_NAME=unihub_workshop
DB_USER=workshop_user
DB_PASSWORD=workshop_local_dev_password

# Optional: Full connection string (if using Prisma or other tools)
# DATABASE_URL=postgresql://workshop_user:workshop_local_dev_password@postgres:5432/unihub_workshop

# ============================================================================
# CACHE & LOCK STORE (Redis)
# ============================================================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_local_dev_password
REDIS_DB=0

# Optional: Full connection string
# REDIS_URL=redis://:redis_local_dev_password@redis:6379/0

# ============================================================================
# MESSAGE BROKER (RabbitMQ)
# ============================================================================

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=workshop_user
RABBITMQ_PASSWORD=rabbitmq_local_dev_password

# Optional: Full connection string
# RABBITMQ_URL=amqp://workshop_user:rabbitmq_local_dev_password@rabbitmq:5672/

# RabbitMQ Management UI Access
# URL: http://localhost:15672
# Username: workshop_user
# Password: rabbitmq_local_dev_password

# ============================================================================
# AUTHENTICATION (JWT)
# ============================================================================

# Must be at least 32 characters for security
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-required-here!!!
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-required-here!!!

# Access token expiry in seconds (3600 = 1 hour)
JWT_EXPIRY=3600

# Refresh token expiry in days (7 = 1 week)
REFRESH_TOKEN_EXPIRY_DAYS=7

# ============================================================================
# PAYMENT GATEWAY - VNPay (Test/Sandbox)
# ============================================================================

# Use MOCK keys for local development
VNPAY_API_KEY=MOCK-VNPAY-TEST-KEY-DO-NOT-USE-IN-PRODUCTION
VNPAY_API_ENDPOINT=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_MERCHANT_CODE=TMNCODE
VNPAY_RETURN_URL=http://localhost:3000/api/payments/webhook
VNPAY_SECRET_KEY=MOCK-VNPAY-SECRET

# Mock Payment Behavior:
# - amount < 10000 → SUCCESS
# - 10000 <= amount < 50000 → PENDING (timeout)
# - amount >= 50000 → FAILED

# ============================================================================
# PAYMENT GATEWAY - MoMo (Test/Sandbox)
# ============================================================================

# Use MOCK keys for local development
MOMO_API_KEY=MOCK-MOMO-TEST-KEY-DO-NOT-USE-IN-PRODUCTION
MOMO_API_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=MOMO123456
MOMO_RETURN_URL=http://localhost:3000/api/payments/webhook
MOMO_SECRET_KEY=MOCK-MOMO-SECRET

# ============================================================================
# EMAIL SERVICE (SendGrid)
# ============================================================================

SENDGRID_API_KEY=SG.test_key_for_development_only_DO_NOT_USE_IN_PRODUCTION
SENDGRID_FROM_EMAIL=noreply@unihub-local.dev

# For production, use real SendGrid API key
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SENDGRID_FROM_EMAIL=noreply@yourcompany.com

# ============================================================================
# AI INTEGRATION (Google Vertex AI / Generative AI)
# ============================================================================

# For local development without GCP access, use MOCK
VERTEX_AI_API_KEY=AIzaSyDxxxxxx_MOCK_KEY_USE_FOR_DEVELOPMENT_ONLY
VERTEX_AI_PROJECT_ID=unihub-dev-project
VERTEX_AI_MODEL=gemini-pro
VERTEX_AI_LOCATION=us-central1

# For production, obtain a real GCP service account key
# See: https://cloud.google.com/docs/authentication/getting-started

# ============================================================================
# FILE STORAGE
# ============================================================================

FILE_UPLOAD_DIR=/uploads
MAX_FILE_SIZE_MB=50

# ============================================================================
# DATABASE CONNECTION POOL (Advanced)
# ============================================================================

DATABASE_POOL_SIZE=10
DATABASE_IDLE_TIMEOUT=30

# ============================================================================
# RABBITMQ ADVANCED (Advanced)
# ============================================================================

RABBITMQ_PREFETCH_COUNT=10

# ============================================================================
# CORS & SECURITY (Optional)
# ============================================================================

CORS_ORIGIN=http://localhost:3001,http://localhost:3000
CORS_CREDENTIALS=true

# ============================================================================
# RATE LIMITING (Optional)
# ============================================================================

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# BACKUP & MAINTENANCE (Optional)
# ============================================================================

# Enable automatic daily backup
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_TIME=02:00

# ============================================================================
# DEVELOPMENT ONLY FLAGS (Optional)
# ============================================================================

# Enable verbose logging for debugging
DEBUG=unihub:*

# Skip JWT validation (NOT for production)
SKIP_JWT_VALIDATION=false

# Use in-memory mock implementations instead of real services
USE_MOCK_SERVICES=false
